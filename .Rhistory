df$TimeRange <- as.factor(df$TimeRange)
summary(df)
levels(df$Line)
df$Line <- as.character(df$Line)
# Replace known variations
df$Line[df$Line %in% c("YUS", "LINE 1", "ONGE-UNIVERSITY AND BL")] <- "YU"
df$Line[df$Line %in% c("BLOOR DANFORTH")] <- "BD"
df$Line[df$Line %in% c("SHEP")] <- "SHP"
# Replace all combo labels with "YU-BD"
df$Line[df$Line %in% c("YU / BD", "YU/ BD", "YU/BD", "YU & BD", "YUS/BD", "BD/YU", "BD / YU", "BD/ YU", "BD/ YUS", "YU/BD/SHP")] <- "YU-BD"
# Remove irrelevant labels
df$Line[df$Line %in% c("TRACK LEVEL ACTIVITY", "109 RANEE", "20 CLIFFSIDE", "")] <- NA
df <- df[!is.na(df$Line), ]
# Convert back to factor
df$Line <- factor(df$Line)
# Check final cleaned levels
levels(df$Line)
summary(df)
# Remove rows where Line is "SRT"
df <- df[df$Line != "SRT", ]
# Drop unused factor levels
df$Line <- droplevels(df$Line)
# Check final levels
levels(df$Line)
levels(df$Code)
df$Code <- as.character(df$Code)
# Remove invalid codes
df$Code[df$Code %in% c("", "XXXXX")] <- NA
# Group by prefix-based categories aligned with descriptions
df$CodeGroup <- NA
# EU = Equipment-related (RC&S + mechanical)
df$CodeGroup[grepl("^EU", df$Code)] <- "Equipment Issue"
# MU = Miscellaneous Utility (includes injuries, ESA, etc.)
df$CodeGroup[grepl("^MU", df$Code)] <- "Operational/Medical"
# PU = Power, Communications, Signal-related
df$CodeGroup[grepl("^PU", df$Code)] <- "Signal/Power/Comms"
# SU = Security or Police-related
df$CodeGroup[grepl("^SU", df$Code)] <- "Security/Police"
# TU = Operator or Transit related errors
df$CodeGroup[grepl("^TU", df$Code)] <- "Operator Error / Transit Control"
# Everything else
df$CodeGroup[is.na(df$CodeGroup)] <- "Other"
# Drop any rows with missing Code
df <- df[!is.na(df$Code), ]
# Convert back to factors
df$Code <- factor(df$Code)
df$CodeGroup <- factor(df$CodeGroup)
summary(df)
df$Bound <- as.character(df$Bound)
# Drop rows where Bound == "B"
df <- df[df$Bound != "B", ]
df$Bound <- as.factor(df$Bound)
# Droppin the code column
df <- df[ ,-4]
summary(df)
# -------------------------------
# 1. Clean and simplify Station names
# -------------------------------
# Convert Station to uppercase and trim spaces
df$Station <- toupper(trimws(df$Station))
# Remove common suffixes like " STATION", text after dashes, and redundant line codes
df$Station <- gsub(" STATION.*", "", df$Station)
df$Station <- gsub(" BD$", "", df$Station)
df$Station <- gsub(" YU$", "", df$Station)
df$Station <- gsub(" -.*", "", df$Station)
df$Station <- gsub(" +", " ", df$Station)
df$Station <- trimws(df$Station)
# -------------------------------
# 2. Remove irrelevant/general stations or vague entries
# -------------------------------
irrelevant_patterns <- c(
"LINE", "YARD", "WYE", "SHOP", "BUILDING", "CAR HOUSE", "CARHOUSE", "COMPLEX",
"SUBWAY", "SUBSTATION", "CLOSURE", "SYSTEM", "UNKNOWN", "TRACK", "DIVISION",
"HOSTLER", "TRAINING", "EE", "EMERGENCY", "APPROACHING", "TO", "BETWEEN",
"AND", "VARIOUS", "CHANGE OVER", "OPERATIONS", "UNION TO", "YU-", "YU & BD"
)
# Remove rows that contain any of the above patterns
remove_rows <- grepl(paste(irrelevant_patterns, collapse = "|"), df$Station)
df <- df[!remove_rows, ]
# -------------------------------
# 3. Re-factor Station
# -------------------------------
df$Station <- factor(df$Station)
levels(df$Station)
df$Station <- as.character(df$Station)
# Fix common typos and duplicates
df$Station[df$Station == "KENNDY"] <- "KENNEDY"
df$Station[df$Station == "KILPING"] <- "KIPLING"
df$Station[df$Station == "ST GEOGE"] <- "ST GEORGE"
df$Station[df$Station == "ST. CLAIR"] <- "ST CLAIR"
df$Station[df$Station == "ST. CLAIR WEST"] <- "ST CLAIR WEST"
df$Station[df$Station == "ST. GEORGE"] <- "ST GEORGE"
df$Station[df$Station == "WISLON"] <- "WILSON"
df$Station[df$Station == "YOUNGE-UNIVERSITY-SPAD"] <- "YONGE-UNIVERSITY-SPADINA"
df$Station[df$Station == "FINCH STN 39 BUS PLATF"] <- "FINCH"
df$Station[df$Station %in% c("DAVISVILLE BUILD-UP", "DAVISVILLE BUILD UP", "DAVISVILLE BUILDUP")] <- "DAVISVILLE"
df$Station[df$Station == "OLD MILLS"] <- "OLD MILL"
df$Station[df$Station %in% c("SHEPPARD YONGE", "SHEPPARD-YONGE")] <- "SHEPPARD-YONGE"
df$Station[df$Station == "SPADINA YUS"] <- "SPADINA"
df$Station[df$Station == "BLOOR SATION"] <- "BLOOR"
df$Station[df$Station == "DOWNVIEW PARK STN"] <- "DOWNSVIEW PARK"
df$Station[df$Station == "FINCH WEST CENTER TRAC"] <- "FINCH WEST"
df$Station[df$Station == "LAWRENCE WEST CENTER T"] <- "LAWRENCE WEST"
df$Station[df$Station == "OSGOODE POCKET"] <- "OSGOODE"
df$Station[df$Station %in% c("SCARBOROUGH CENTRE STA", "SCARBOROUGH CTR STATIO")] <- "SCARBOROUGH CENTRE"
df$Station[df$Station == "SHEBOURNE"] <- "SHERBOURNE"
df$Station[df$Station %in% c("ST GEORGE BD/YU STATIO", "ST GEORGE YUS")] <- "ST GEORGE"
df$Station[df$Station == "YORK UNIVERSITY STATIO"] <- "YORK UNIVERSITY"
df$Station[df$Station == "KING COMMERCE"] <- "KING"
df$Station[df$Station == "VAUGHAN MC"] <- "VMC"
df$Station[df$Station == "NORTH YORK CTR"] <- "NORTH YORK CENTRE"
df$Station[df$Station == "SHEPPARD TAIL"] <- NA  # if not a valid stop
df$Station[df$Station == "YONGE"] <- "YONGE-UNIVERSITY-SPADINA"
df <- df[!is.na(df$Station), ]
df$Station <- factor(df$Station)
# Collapse YONGE variants
df$Station[df$Station %in% c(
"YONGE-UNIVERISTY & BLO", "YONGE-UNIVERSITY", "YONGE-UNIVERSITY-SPADI",
"YONGE-UNIVERSITY & BLO", "YONGE-UNIVERSITY SUBWA", "YONGE / UNIVERSITY LIN",
"YONGE UNIVERSITY", "YONGE UNIVERSITY / BLO", "YONGE UNIVERSITY SUBWA",
"YONGE/UNIVERSITY/SPADI"
)] <- "YONGE-UNIVERSITY-SPADINA"
# Drop ambiguous or irrelevant entries
drop_stations <- c(
"JANE & RUNNYMEDE STATI",
"KENNEDY, DON MILLS, SC",
"LOST ARTICLES OFFICE",
"MCDONALD CARTIER EMERG",
"MULTIPLE"
)
df <- df[!df$Station %in% drop_stations, ]
# Remove non-public stations
df <- df[!df$Station %in% c(
"111 SPADINA ROAD",
"1900 YONGE MCBRIEN BLD",
"1900 YONGE ST- MCBRIEN",
"2233 SHEPPARD WEST",
"ALL",
"BUCHAN ESB"
), ]
# merge "YONGE-UNIVERSITY-SPADINA" into "YONGE-UNIVERSITY"
df$Station <- as.character(df$Station)
df$Station[df$Station == "YONGE-UNIVERSITY-SPADINA"] <- "YONGE-UNIVERSITY"
df$Station <- factor(df$Station)
# Refactor again
df$Station <- factor(df$Station)
levels(df$Station)
# Count frequency of each station
station_counts <- as.data.frame(table(df$Station))
# Order by descending frequency
station_counts <- station_counts[order(-station_counts$Freq), ]
# Take top 5
top5_stations <- head(station_counts, 5)
# Bar plot
library(ggplot2)
ggplot(top5_stations, aes(x = reorder(Var1, -Freq), y = Freq)) +
geom_bar(stat = "identity", fill = "steelblue") +
labs(title = "Top 5 Stations with Most Delays",
x = "Station",
y = "Number of Delays") +
theme_minimal()
# Gather Min.Delay and Min.Gap into one long-format data frame
delay_data <- data.frame(
Category = rep(c("Min.Delay", "Min.Gap"), each = nrow(df)),
Value = c(df$Min.Delay, df$Min.Gap)
)
# Box-Plot of Minutes of Delay and Gap
ggplot(delay_data, aes(x = Category, y = Value)) +
geom_boxplot(fill = "lightgreen") +
labs(title = "Boxplot of Min.Delay and Min.Gap",
x = "",
y = "Minutes") +
theme_minimal()
par(mfrow = c(2, 2))
# histgram of distribution
hist(df$Min.Delay,
main = "Delay (in Minutes)",
xlab = "Value",
ylab = "Frequency",
col = "#ADD8E6",
freq = FALSE) # `freq = FALSE` scales the histogram for overlaying density
lines(density(df$Min.Delay))
hist(df$Min.Gap,
main = "Gap (in Minutes)",
xlab = "Value",
ylab = "Frequency",
col = "#ADD8E6",
freq = FALSE) # `freq = FALSE` scales the histogram for overlaying density
lines(density(df$Min.Gap))
df <- df[df$Min.Delay <= 50 & df$Min.Gap <= 50, ]
# Gather Min.Delay and Min.Gap into one long-format data frame
delay_data <- data.frame(
Category = rep(c("Min.Delay", "Min.Gap"), each = nrow(df)),
Value = c(df$Min.Delay, df$Min.Gap)
)
# Plot
ggplot(delay_data, aes(x = Category, y = Value)) +
geom_boxplot(fill = "lightgreen") +
labs(title = "Boxplot of Min.Delay and Min.Gap",
x = "",
y = "Minutes") +
theme_minimal()
stat.desc(df[, c("Min.Delay", "Min.Gap")])
cr <- cor(df[sapply(df, is.numeric)], method="spearman")
round(cr, 2)
df <- df[, -5]
summary(df)
par(mfrow = c(2, 2))
hist(df$Min.Delay,
main = "Delay (in Minutes)",
xlab = "Value",
ylab = "Frequency",
col = "#ADD8E6",
freq = FALSE) # `freq = FALSE` scales the histogram for overlaying density
lines(density(df$Min.Delay))
