# Load data
df <- read.table("ttc-subway-delay-data-2024.csv",
header=TRUE,
sep=",",
quote = "\"",
fill = TRUE,
stringsAsFactors = FALSE)
df <- as.data.frame(df)
head(df)
summary(df)
df <- na.omit(df)
summary(df)
# Change Date to MM/DD/YYYY
df$Date <- as.Date(df$Date)
# Extract Hour and convert them to numeric
df$Hour <- as.numeric(sub(":.*", "", df$Time))
# Assign Hours to TimeRange as defined above
df$TimeRange <- with(df, ifelse(Hour >= 5 & Hour < 9, "Early Morning",
ifelse(Hour >= 9 & Hour < 12, "Morning",
ifelse(Hour >= 12 & Hour < 17, "Afternoon",
ifelse(Hour >= 17 & Hour < 21, "Evening", "Night")))))
summary(df)
df <- df[ ,-2]
df <- df[ ,-10]
df$Day <- as.factor(df$Day)
df$Station <- as.factor(df$Station)
df$Code <- as.factor(df$Code)
df$Bound <- as.factor(df$Bound)
df$Line <- as.factor(df$Line)
df$Vehicle <- as.factor(df$Vehicle)
df$TimeRange <- as.factor(df$TimeRange)
summary(df)
levels(df$Line)
df$Line <- as.character(df$Line)
# Replace known variations
df$Line[df$Line %in% c("YUS", "LINE 1", "ONGE-UNIVERSITY AND BL")] <- "YU"
df$Line[df$Line %in% c("BLOOR DANFORTH")] <- "BD"
df$Line[df$Line %in% c("SHEP")] <- "SHP"
# Replace all combo labels with "YU-BD"
df$Line[df$Line %in% c("YU / BD", "YU/ BD", "YU/BD", "YU & BD", "YUS/BD", "BD/YU", "BD / YU", "BD/ YU", "BD/ YUS", "YU/BD/SHP")] <- "YU-BD"
# Remove irrelevant labels
df$Line[df$Line %in% c("TRACK LEVEL ACTIVITY", "109 RANEE", "20 CLIFFSIDE", "")] <- NA
df <- df[!is.na(df$Line), ]
# Convert back to factor
df$Line <- factor(df$Line)
# Check final cleaned levels
levels(df$Line)
summary(df)
levels(df$Code)
df$Code <- as.character(df$Code)
# Remove invalid codes
df$Code[df$Code %in% c("XXXXX")] <- NA
df <- df[!is.na(df$Code), ]
df$Code <- factor(df$Code)
summary(df)
df$Bound <- as.character(df$Bound)
# Drop rows where Bound == "B"
df <- df[df$Bound != "B", ]
df$Bound <- as.factor(df$Bound)
summary(df)
# -------------------------------
# 1. Clean and simplify Station names
# -------------------------------
# Convert Station to uppercase and trim spaces
df$Station <- toupper(trimws(df$Station))
# Remove common suffixes like " STATION", text after dashes, and redundant line codes
df$Station <- gsub(" STATION.*", "", df$Station)
df$Station <- gsub(" BD$", "", df$Station)
df$Station <- gsub(" YU$", "", df$Station)
df$Station <- gsub(" -.*", "", df$Station)
df$Station <- gsub(" +", " ", df$Station)
df$Station <- trimws(df$Station)
# -------------------------------
# 2. Remove irrelevant/general stations or vague entries
# -------------------------------
irrelevant_patterns <- c(
"LINE", "YARD", "WYE", "SHOP", "BUILDING", "CAR HOUSE", "CARHOUSE", "COMPLEX",
"SUBWAY", "SUBSTATION", "CLOSURE", "SYSTEM", "UNKNOWN", "TRACK", "DIVISION",
"HOSTLER", "TRAINING", "EE", "EMERGENCY", "APPROACHING", "TO", "BETWEEN",
"AND", "VARIOUS", "CHANGE OVER", "OPERATIONS", "UNION TO", "YU-", "YU & BD"
)
# Remove rows that contain any of the above patterns
remove_rows <- grepl(paste(irrelevant_patterns, collapse = "|"), df$Station)
df <- df[!remove_rows, ]
# -------------------------------
# 3. Re-factor Station
# -------------------------------
df$Station <- factor(df$Station)
# Prepare data in long format
delay_data <- data.frame(
Category = c(rep("Min.Delay", length(df$Min.Delay)),
rep("Min.Gap", length(df$Min.Gap))),
Value = c(df$Min.Delay, df$Min.Gap)
)
# Plot
ggplot(delay_data, aes(x = Category, y = Value)) +
geom_boxplot(fill = "lightgreen") +
labs(title = "Boxplot of Min.Delay and Min.Gap",
x = "",
y = "Minutes") +
theme_minimal()
df <- df[df$Min.Delay <= 50 & df$Min.Gap <= 50, ]
# Prepare data in long format
delay_data <- data.frame(
Category = c(rep("Min.Delay", length(df$Min.Delay)),
rep("Min.Gap", length(df$Min.Gap))),
Value = c(df$Min.Delay, df$Min.Gap)
)
# Plot
ggplot(delay_data, aes(x = Category, y = Value)) +
geom_boxplot(fill = "lightgreen") +
labs(title = "Boxplot of Min.Delay and Min.Gap",
x = "",
y = "Minutes") +
theme_minimal()
stat.desc(df[, c("Min.Delay", "Min.Gap")])
par(mfrow = c(2, 2))
hist(df$Min.Delay,
main = "Delay (in Minutes)",
xlab = "Value",
ylab = "Frequency",
col = "#ADD8E6",
freq = FALSE) # `freq = FALSE` scales the histogram for overlaying density
lines(density(df$Min.Delay))
hist(df$Min.Gap,
main = "Gap (in Minutes)",
xlab = "Value",
ylab = "Frequency",
col = "#ADD8E6",
freq = FALSE) # `freq = FALSE` scales the histogram for overlaying density
lines(density(df$Min.Gap))
df <- df[df$Min.Delay > 0 & df$Min.Gap > 0, ]
par(mfrow = c(2, 2))
hist(df$Min.Delay,
main = "Delay (in Minutes)",
xlab = "Value",
ylab = "Frequency",
col = "#ADD8E6",
freq = FALSE) # `freq = FALSE` scales the histogram for overlaying density
lines(density(df$Min.Delay))
hist(df$Min.Gap,
main = "Gap (in Minutes)",
xlab = "Value",
ylab = "Frequency",
col = "#ADD8E6",
freq = FALSE) # `freq = FALSE` scales the histogram for overlaying density
lines(density(df$Min.Gap))
cr <- cor(df[sapply(df, is.numeric)], method="spearman")
round(cr, 2)
df <- df[, -6]
summary(df)
df$Bound <- as.character(df$Bound)
df$Vehicle <- as.character(df$Vehicle)
# Remove rows with invalid Bound or Vehicle
df <- df[df$Bound != "" & df$Vehicle != "0", ]
df$Bound <- as.factor(df$Bound)
df$Vehicle <- as.factor(df$Vehicle)
df$DelayOver5 <- df$Min.Delay > 5
df <- df[, -5]
# Create new WeekGroup variable
df$Day <- as.character(df$Day)
df$WeekGroup <- ifelse(df$Day %in% c("Saturday", "Sunday"), "Weekend", "Weekday")
df$WeekGroup <- factor(df$WeekGroup)
df <- df[, -2]
summary(df)
### Droping Date column
df <- df[, -1]
code_freq <- table(df$Code)
top5 <- sort(code_freq, decreasing = TRUE)[1:5]
top5_df <- data.frame(Code = names(top5), Frequency = as.numeric(top5))
ggplot(top5_df, aes(x = reorder(Code, Frequency), y = Frequency)) +
geom_bar(stat = "identity", fill = "steelblue") +
coord_flip() +
labs(title = "Top 5 Delay Causes",
x = "Delay Code",
y = "Number of Delays") +
theme_minimal()
code_legend <- read.csv("Code Descriptions.csv", stringsAsFactors = FALSE)
top5_description <- merge(top5_df, code_legend, by = "Code")
top5_description
station_counts <- sort(table(df$Station), decreasing = TRUE)
top_stations <- data.frame(Station = names(station_counts), Frequency = as.numeric(station_counts))
ggplot(head(top_stations, 10), aes(x = reorder(Station, Frequency), y = Frequency)) +
geom_bar(stat = "identity", fill = "tomato") +
coord_flip() +
labs(title = "Top 10 Delayed Stations",
x = "Station",
y = "Number of Delays") +
theme_minimal()
# 80% train and 20 % test
sr<- 0.80
# Find number of rows of data
n.row <- nrow(df)
n.row
set.seed(8848)
training.rows <- sample(1:n.row, sr*n.row, replace=FALSE)
#Assign to the training sample
train <- subset(df[training.rows,])
#Assign the balance to the test sample
test <- subset(df[-c(training.rows),])
summary(train)
summary(test)
# Keep only variables with manageable cardinality
#df_clean <- df[, c("Line", "TimeRange", "Bound", "Code", "WeekGroup", "DelayOver5")]
#hc <- hetcor(df)
#round(hc$correlations, 2)
day_plot <- table(df$DelayOver5, df$WeekGroup)
time_plot <- table(df$DelayOver5, df$TimeRange)
bound_plot <- table(df$DelayOver5, df$Bound)
line_plot <- table(df$DelayOver5, df$Line)
station_plot <- table(df$DelayOver5, df$Station)
code_plot <- table(df$DelayOver5, df$Code)
par(mfrow=c(2,2))
barplot((day_plot),beside=T)
barplot((time_plot),beside=T)
barplot((bound_plot),beside=T)
barplot((line_plot),beside=T)
par(mfrow=c(1,1))
barplot((station_plot),beside=T)
barplot((code_plot),beside=T)
start <- Sys.time()
glm.all <- glm(DelayOver5 ~ .,
data = train,
family="binomial")
end <- Sys.time()
glm_all_summary <- summary(glm.all)
glm_all_summary
# Model summary
fisher_iterations_all <- glm_all_summary$iter
aic_value_all <- glm_all_summary$aic
residual_deviance_all <- glm_all_summary$deviance
p_values_all <- glm_all_summary$coefficients[, "Pr(>|z|)"]
intercept_p_value_all <- p_values_all["(Intercept)"]
intercept_status_all <- ifelse(intercept_p_value_all >= 0.05, "Fail", "Pass")
other_p_values_all <- p_values_all[names(p_values_all) != "(Intercept)"]
passed_count_all <- sum(other_p_values_all < 0.05)
total_count_all <- length(other_p_values_all)
cov_stat_all <- ifelse(fisher_iterations_all <= 1.5*ncol(train),"It converged","It does not converge")
cat("Number of Fisher Scoring Iterations:", fisher_iterations_all, ": **",cov_stat_all,"**\n")
print("### using passing standard of: number of iterations <= (1.5 * number of variables); as discussed in class ###")
cat("AIC: **", aic_value_all, "**\n")
cat("Residual Deviance: **", residual_deviance_all, "**\n")
cat("Intercept Pr(>|z|): **", intercept_status_all, "**\n")
cat("Other variables Pr(>|z|): **", passed_count_all, "out of", total_count_all,"Passed **\n\n" )
time_all <- end - start
time_all
# All variables
plot(glm.all, which=4, id.n=6)
cat("Training\n")
pred_all <- predict(glm.all, newdata=train, type="response")
Class_all <- ifelse(pred_all < 0.6,"Over5","Below5")
CF_all <- table(train$DelayOver5, Class_all)
Acc_all <- (CF_all[1,1]+CF_all[2,2])/sum(CF_all)
CF_all
cat("Accuracy: **", round(Acc_all,4), "**\n\n")
cat("Testing\n")
